# Names only. Real values live in the secret store (test, production) and in .env.local (development).
# Full list and owners: docs/ARCHITECTURE.md §09.

# apps/web (validated in apps/web/src/lib/env.ts)
# Base URL of the NestJS API, e.g. http://localhost:4000
API_BASE_URL=

# Supabase (hosted dev project, EU region). Publishable key: public by design; secret key: api and worker only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# apps/api (validated in apps/api/src/env.ts)
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# OpenAI: invoice extraction (T-034). Key: api only. Model id is configuration (ARCHITECTURE §06).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Development only: "true" enables the "Összes számla törlése" button (DELETE /invoices). Never in production.
ALLOW_DATA_RESET=false
# Shared secret between apps/scale-agent and the API (at least 32 characters, e.g. `openssl rand -hex 32`). Same value on both sides.
SCALE_AGENT_TOKEN=

# Supabase connection string (session pooler) for Drizzle
DATABASE_URL=

# Supabase Storage, S3-compatible endpoint: https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# NAV EKÁER (apps/worker only, secret store). EKAER_BASE_URL has no default; development uses the test host only:
# https://import-test.ekaer.nav.gov.hu/TradeCardManagementService/customer (the production host is refused outside production).
EKAER_BASE_URL=
EKAER_USER=
EKAER_PASSWORD=
EKAER_SIGNING_KEY=
EKAER_TAX_NUMBER=
# "true": apps/worker uses an in-process NAV stand-in instead of the EKAER_* settings (until a test-system user exists).
EKAER_SIMULATE=false

# Local services from infra/docker-compose.yml
TEMPORAL_ADDRESS=localhost:7233
GOTENBERG_URL=http://localhost:3001
